# Facet — device configuration template.
#
#   cp .env.example .env    then fill in the values below
#
# .env is gitignored and never leaves your machine. CMake reads it at configure
# time and generates build/generated/credentials.h, so editing .env and running
# `idf.py build` is all it takes — there is no header to hand-edit.

# The only two you actually need. The WI-FI app can also set them at runtime,
# and whatever it saves wins over these.
WIFI_SSID=
WIFI_PASSWORD=

# An HTTPS endpoint to poll — a Tailscale Funnel URL in practice, e.g.
#   https://yourbox.tailXXXX.ts.net/stt/health
# Leave STT_BEARER_TOKEN empty to send no Authorization header.
STT_ENDPOINT_URL=https://example.com/
STT_BEARER_TOKEN=

# POSIX TZ string for the lock-screen clock.
TIMEZONE=EST5EDT,M3.2.0,M11.1.0
NTP_SERVER=pool.ntp.org

# Unsplash. Only the Access Key is needed — public read endpoints use
# Client-ID auth. The Secret Key is for OAuth user flows Facet does not use,
# so it deliberately never reaches the device.
UNSPLASH_KEY=

# Wallpaper themes, separated by ';'. One is picked at random per download, so
# the pool on the card ends up mixed rather than all one subject. Keep each
# theme to a few words — narrow phrases return far more coherent results than
# long keyword piles. Spaces are fine; they get URL-encoded.
UNSPLASH_QUERY=deep space nebula;galaxy astrophotography;earth from orbit;cyberpunk neon night;synthwave retro futurism;futuristic sci-fi concept;brutalist architecture;modern architecture facade;tokyo street at night;city skyline night;aurora borealis;foggy mountain landscape;misty forest;desert dunes;lightning storm clouds;volcanic landscape iceland;underwater ocean light;long exposure light trails

# Spotify remote. The Client ID is public by design. Only the ACCESS/REFRESH
# tokens are secret, and PKCE means no client secret ever reaches the device.
SPOTIFY_CLIENT_ID=
SPOTIFY_REFRESH_TOKEN=

# Facet broker (see broker/). Used for one-time pairing and for album art, which
# it returns pre-decoded so the device does no image decoding at all. Playback
# control goes straight to Spotify, so the broker being down costs only art.
BROKER_URL=https://YOUR-HOST.tsXXXX.ts.net
BROKER_TOKEN=
