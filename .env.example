# Facet — device configuration.
# Real values live here. This file is gitignored and never leaves the machine.
# Copy .env.example to .env and fill it in; the build turns it into
# build/generated/credentials.h automatically.

WIFI_SSID=your-network
WIFI_PASSWORD=your-password

# Tailscale Funnel endpoint for the speech-to-text service.
# Leave STT_BEARER_TOKEN empty to skip the Authorization header.
STT_ENDPOINT_URL=https://yourbox.tailXXXX.ts.net/stt/health
STT_BEARER_TOKEN=

# POSIX TZ string for the lock-screen clock.
TIMEZONE=EST5EDT,M3.2.0,M11.1.0
NTP_SERVER=pool.ntp.org

# Unsplash. Only the Access Key is needed — public read endpoints use
# Client-ID auth. The Secret Key is for OAuth user flows Facet does not use,
# so it deliberately never reaches the device.
UNSPLASH_KEY=
UNSPLASH_QUERY=space,nebula,astronomy
