# Facet — device configuration template.
#
#   cp .env.example .env    then fill in the values below
#
# .env is gitignored and never leaves your machine. CMake reads it at configure
# time and generates build/generated/credentials.h, so editing .env and running
# `idf.py build` is all it takes — there is no header to hand-edit.

# The only two you actually need. The WI-FI app can also set them at runtime,
# and whatever it saves wins over these.
WIFI_SSID=
WIFI_PASSWORD=

# An HTTPS endpoint to poll — a Tailscale Funnel URL in practice, e.g.
#   https://yourbox.tailXXXX.ts.net/stt/health
# Leave STT_BEARER_TOKEN empty to send no Authorization header.
STT_ENDPOINT_URL=https://example.com/
STT_BEARER_TOKEN=

# POSIX TZ string for the lock-screen clock.
TIMEZONE=EST5EDT,M3.2.0,M11.1.0
NTP_SERVER=pool.ntp.org

# Unsplash. Only the Access Key is needed — public read endpoints use
# Client-ID auth. The Secret Key is for OAuth user flows Facet does not use,
# so it deliberately never reaches the device.
UNSPLASH_KEY=
UNSPLASH_QUERY=space,nebula,astronomy
