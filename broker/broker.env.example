# Install as /etc/facet-broker.env with mode 0600.

# From the Spotify dashboard app you registered.
SPOTIFY_CLIENT_ID=

# Must match a Redirect URI registered on that app, character for character.
SPOTIFY_REDIRECT_URI=https://YOUR-HOST.tsXXXX.ts.net/callback

# Optional. PKCE does not need it, and leaving it out is what lets the cube
# refresh its own token without a secret in firmware. Only set it if you
# deliberately want a confidential client.
SPOTIFY_CLIENT_SECRET=

# Shared secret the cube presents on /token and /art. Must match BROKER_TOKEN in
# the firmware's .env. Generate with:  openssl rand -hex 32
BROKER_TOKEN=
