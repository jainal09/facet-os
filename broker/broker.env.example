# Install as /etc/facet-broker.env with mode 0600.

# From the Spotify dashboard app you registered.
SPOTIFY_CLIENT_ID=

# Must match a Redirect URI registered on that app, character for character.
SPOTIFY_REDIRECT_URI=https://YOUR-HOST.tsXXXX.ts.net/callback

# Public HTTPS origin encoded in the cube's Spotify pairing QR. If omitted it is
# derived from SPOTIFY_REDIRECT_URI. Paths, query strings, and fragments are
# rejected so configuration cannot silently send login QR codes elsewhere.
BROKER_PUBLIC_URL=https://YOUR-HOST.tsXXXX.ts.net

# Optional. PKCE does not need it. Only set it if you deliberately want a
# confidential client.
SPOTIFY_CLIENT_SECRET=

# One unique bearer per user/cube. The label is local to this broker and the
# token must match BROKER_TOKEN in only that cube's firmware .env.
# Bearers shorter than 32 characters are rejected at startup.
# Generate each token with: openssl rand -hex 32
BROKER_USERS=alice=TOKEN_FOR_ALICE_CUBE,bob=TOKEN_FOR_BOB_CUBE

# Legacy single-user deployments only. When set, this creates a user named
# "default". Leave it empty when BROKER_USERS is configured.
BROKER_TOKEN=
